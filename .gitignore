# ==============================================================================
# Boom .gitignore
# ==============================================================================

# External tools & submodules (Do not upload)
/X-AnyLabeling/
/cvat/
/wildfire-real-time-segmentation/

# Test directories (Do not upload)
/test/
/tests/

# Data: preserve folder structure with .gitkeep only, never upload datasets/videos
/data/**
!/data/**/
!/data/**/.gitkeep

# Models: preserve folder structure with .gitkeep only, never upload weights/checkpoints
/models/**
!/models/**/
!/models/**/.gitkeep

# Outputs: never upload experiment/run outputs
/output/**
!/output/**/
!/output/**/.gitkeep
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep

# Large media, binary files and weights
*.[mM][pP]4
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[pP][tT]
*.[pP][tT][hH]
*.ckpt
*.onnx
*.engine
*.safetensors
events.out.tfevents.*

# Asset: preserve all asset files (UI icons, pictures, geojson), EXCEPT heavy maps
!/asset/**
/asset/maps/**
!/asset/maps/
!/asset/maps/.gitkeep
!/asset/pictures/**
!/asset/ui/**

# Backups, staging and temporary directories
*.backup_*/
*.staging_*/
_map_cache/
*.cache
tmp/
temp/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# IDE & Editor files
.idea/
.vscode/
